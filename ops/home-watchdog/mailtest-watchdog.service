# /etc/systemd/system/mailtest-watchdog.service
#
# One-shot health probe + auto-heal for the local mailtest API. Triggered
# every minute by mailtest-watchdog.timer. Setup notes: ops/home-watchdog/README.md.

[Unit]
Description=Mailtest local API health watchdog (one-shot)
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=oneshot
User=justin
# Need the standard PATH so curl + docker resolve, and a HOME for any
# docker-credential-helper lookups docker compose might do.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/justin

# Cooldown state lives in $HOME/.cache/mailtest-watchdog (see the script).
# Do NOT use RuntimeDirectory for that — Type=oneshot wipes it on exit and
# defeated the Layer 2 diagnostic rate-limit.

ExecStart=/home/justin/mailtest/ops/home-watchdog/mailtest-watchdog.sh

# 0 = healthy / healed
# 1 = Layer 1 cooldown skip
# 4 = Layer 2 public-URL down (diagnostic logged or cooldown skip)
# 2/3 remain real failures (cannot cd / still down after restart).
SuccessExitStatus=0 1 4
